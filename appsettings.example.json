{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=dtt_healthcare;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Include Error Detail=true"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SUPER_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "DTT_Backend",
    "Audience": "DTT_Patients_App"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-3.6-flash",
    "TimeoutSeconds": 12
  },
  "AllowedHosts": "*",
  "VnPay": {
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "ReturnUrl": "http://localhost:5000/api/Invoices/vnpay-callback",
    "PaymentBackReturnUrl": "http://localhost:5000/api/Invoices/vnpay-callback"
  },
  "VietQR": {
    "BankId": "MB",
    "BankName": "Ngân hàng Quân Đội (MB Bank)",
    "AccountNo": "YOUR_BANK_ACCOUNT_NO",
    "AccountName": "PHONG KHAM DA KHOA DTT HEALTHCARE",
    "Template": "compact2"
  },
  "PayPalOptions": {
    "Mode": "Sandbox",
    "ClientId": "YOUR_PAYPAL_CLIENT_ID",
    "ClientSecret": "YOUR_PAYPAL_CLIENT_SECRET",
    "ExchangeRateUsd": 25000
  }
}
